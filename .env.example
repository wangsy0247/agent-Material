# ============================================
# 服务监听
# ============================================
AGENT_API_HOST=127.0.0.1
AGENT_API_PORT=8000
# 开发模式热重载：true / false
AGENT_API_RELOAD=false

# 允许的跨域来源（逗号分隔），留空则使用默认本地地址
AGENT_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# 必填：至少 32 字符的随机值。不要把真实值提交到 Git。
# 生成命令：python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=

# 高风险开关：默认禁止通过 HTTP 修改 MCP command/url/env。
AGENT_ALLOW_RUNTIME_MCP_CONFIG=false

# ============================================
# PostgreSQL + pgvector（以下仅为本机开发默认值）
# ============================================
POSTGRES_USER=agent_material
POSTGRES_PASSWORD=agent_material_dev
POSTGRES_DB=langgraph
POSTGRES_PORT=5433
POSTGRES_CHECKPOINTER_URL=postgresql://agent_material:agent_material_dev@localhost:5433/langgraph
PGVECTOR_URL=postgresql+psycopg://agent_material:agent_material_dev@127.0.0.1:5433/langgraph

# ============================================
# 大模型（DashScope / 通义千问）
# ============================================
DASHSCOPE_API_KEY=sk-your-dashscope-key

# ============================================
# Materials Project MCP 服务
# ============================================
MP_API_KEY=your-materials-project-api-key
# 可选：下载结果保存目录与历史文件
# MP_DOWNLOAD_DIR=workspace/mp_downloads
# MP_HISTORY_FILE=downloads/history.txt

# ============================================
# 可观测性（可选）
# ============================================
# LangSmith 追踪
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=agent-material
# Langfuse
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# OpenTelemetry
OTEL_SERVICE_NAME=agent-material
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ============================================
# 高级（可选）
# ============================================
# 扩展配置文件路径（默认读取项目根目录 extensions_config.json）
# AGENT_EXTENSIONS_CONFIG_PATH=extensions_config.json
# 生产环境必须覆盖数据库密码和连接串，且不要将数据库端口暴露到公网。
