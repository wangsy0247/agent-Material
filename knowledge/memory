  📖 快速使用指南
  ───────────────

  1. 创建会话 → 对话 → 结束（自动保存）
  ─────────────────────────────────────

  # 创建会话
  curl -X POST http://localhost:8080/api/v1/memory/sessions \
    -H "Content-Type: application/json" \
    -d '{"title":"材料研究讨论"}'

  # 加载会话
  curl -X POST http://localhost:8080/api/v1/memory/sessions/{session_id}/load

  # Agent 对话（自动记录到当前会话）
  curl -X POST http://localhost:8080/api/v1/agent/chat \
    -H "Content-Type: application/json" \
    -d '{"question":"石墨烯的性质"}'

  # 结束会话（触发自动记忆提取）
  curl -X POST http://localhost:8080/api/v1/memory/sessions/{session_id}/end

  2. 长期记忆操作
  ───────────────

  # 添加用户偏好
  curl -X POST http://localhost:8080/api/v1/memory/add \
    -H "Content-Type: application/json" \
    -d '{"category":"user","content":"用户是材料科学博士生"}'

  # 添加项目知识
  curl -X POST http://localhost:8080/api/v1/memory/add \
    -H "Content-Type: application/json" \
    -d '{"category":"project","content":"当前研究二维材料热导率"}'

  # 召回相关记忆
  curl -X POST http://localhost:8080/api/v1/memory/recall \
    -H "Content-Type: application/json" \
    -d '{"query":"用户的研究方向"}'

  3. 查看记忆文件
  ───────────────

  # 用户画像
  cat workspace/memory/USER.md

  # 项目知识
  cat workspace/memory/MEMORY.md

  # 会话数据库
  sqlite3 logs/memory_sessions.db "SELECT * FROM sessions;"

