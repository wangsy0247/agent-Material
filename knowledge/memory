      # 保护系统提示(前1条) + 最近对话(后4条)
      # 中间消息送入 LLM 生成结构化摘要
      compress(messages, protect_first_n=1, protect_last_n=4)

  2. 借鉴 Hermes-Agent：SQLite WAL + 应用级重试
  ─────────────────────────────────────────────

  # WAL 模式支持多读者单写者
  # 写冲突时随机抖动重试，避免车队效应
  for attempt in range(5):
      try:
          conn.execute(...)
      except sqlite3.OperationalError:
          time.sleep(random.randint(20, 100) * attempt / 1000)

